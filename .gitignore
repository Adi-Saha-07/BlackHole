# ============================================================
# BlackHole Search & AI Engine — .gitignore
# ============================================================

# Environment variables & secrets (NEVER commit to GitHub)
.env
.env.local
.env.*.local

# Databases & local state
*.db
*.sqlite
*.sqlite3
blackhole.db

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDEs & OS specific
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
