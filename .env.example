# ============================================================
# BlackHole Search Engine — Environment Configuration Template
# Copy this file to .env and insert your API keys.
# ============================================================

# ── Flask Server Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=cosmic-event-horizon-secret-key-42

# ── 1. Groq Free AI API Key (Recommended for ultra-fast Llama 3.1 & Qwen)
# Get your free API Key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── 2. Google Gemini AI API (Alternative cloud model)
# Get your API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── 3. Google Custom Search Engine (Optional: for live Google web results)
# Step A: Search API Key: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
# Step B: Search Engine ID (CX): https://programmablesearchengine.google.com/
GOOGLE_SEARCH_CX=your_search_engine_cx_id_here

# ── 4. Redis Caching (Optional — automatically falls back to in-memory cache)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=600

# ── 5. SQLite Search History Database
DATABASE_URL=sqlite:///blackhole.db
